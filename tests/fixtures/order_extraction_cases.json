        "glaze_type": "Men nâu",
        "firing_temperature_c": 1300,
        "deadline_days": 7
      },
      "accept": {
        "product_name": ["Đĩa", "Đĩa gốm sứ"],
        "decoration_pattern": ["Hình chim hạc", "Chim hạc bay"]
