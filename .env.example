# ── LLM provider ──────────────────────────────────────────────────────────
# "openai-compatible" works with any OpenAI-shaped endpoint: OpenRouter,
# Groq, Together, a local Ollama, or OpenAI itself. Use "fake" to run the
# service with a scripted provider and no network / no API key.
AI_PROVIDER=openai-compatible

# Examples:
#   OpenRouter  https://openrouter.ai/api/v1   openai/gpt-4o-mini
#   Groq        https://api.groq.com/openai/v1 llama-3.3-70b-versatile
#   OpenAI      https://api.openai.com/v1      gpt-4o-mini
#   Ollama      http://localhost:11434/v1      qwen2.5:14b
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=

# Deterministic extraction: keep the temperature at 0.
# Structured output: auto | native | tool | prompted
#   auto     native JSON-schema decoding where the profile claims support,
#            tool calling otherwise
#   native   force JSON-schema decoding on for a model the profile table
#            does not recognise
#   tool     the model calls a function with the fields as arguments
#   prompted ask for JSON in the prompt and parse the reply
#
# A model that advertises "tools" in its OpenRouter capability list does not
# necessarily do tool calling *well*. Measured on stealth/ox-alpha with an
# identical request: tool calling 0/5, prompted 5/5 at 4.1s median. If you see
# repeated 502 AI_INVALID_JSON, try prompted before changing model.
AI_OUTPUT_MODE=prompted
# Retries inside one conversation, where the model sees its own parse error.
# Cheap: one short completion, not a fresh inference.
AI_OUTPUT_RETRIES=1

# Reasoning tokens are the largest latency term on reasoning models and buy
# nothing for extraction. "off" is demoted automatically to "minimal" on
# endpoints that reason unconditionally.
AI_REASONING=low

AI_TEMPERATURE=0.0
AI_MAX_TOKENS=768

# Per-attempt provider timeout, and the ceiling for the whole request
# including retries. The budget must be >= the per-attempt timeout.
# One HTTP round-trip.
AI_TIMEOUT_SECONDS=30
# One agent run, which may contain 1 + AI_OUTPUT_RETRIES round-trips.
AI_ATTEMPT_SECONDS=35
# Whole request, transport retries included. Must fit
# AI_ATTEMPT_SECONDS x (AI_MAX_RETRIES + 1) or later retries are truncated.
AI_REQUEST_BUDGET_SECONDS=45
# Retries after the first attempt, so 2 means at most 3 provider calls.
AI_MAX_RETRIES=1

# ── Service ───────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ALLOW_ORIGINS=*

# Leave empty for local development. When set, every /v1 route requires a
# matching X-Internal-API-Key header.
INTERNAL_API_KEY=

MAX_DESCRIPTION_CHARS=4000

# ── Estimation constants ──────────────────────────────────────────────────
# clay_kg  = quantity * CLAY_KG_PER_UNIT * (height_cm / CLAY_REFERENCE_HEIGHT_CM)
# glaze_kg = clay_kg / GLAZE_CLAY_RATIO
# hours    = FIRING_BASE_HOURS + (temp_c - FIRING_TEMP_BASELINE_C) / FIRING_DEGREES_PER_HOUR
CLAY_KG_PER_UNIT=0.9
CLAY_REFERENCE_HEIGHT_CM=35
DEFAULT_HEIGHT_CM=30
GLAZE_CLAY_RATIO=15
FIRING_BASE_HOURS=8
FIRING_TEMP_BASELINE_C=1200
FIRING_DEGREES_PER_HOUR=40

# ── Semantic validation bounds ────────────────────────────────────────────
FIRING_TEMP_MIN_C=600
FIRING_TEMP_MAX_C=1450

# ── Tests ─────────────────────────────────────────────────────────────────
# Set to 1 to allow `pytest -m live` to call the real provider.
RUN_AI_INTEGRATION_TESTS=0
